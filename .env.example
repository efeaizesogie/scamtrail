# All keys are optional. Without a key, that source shows as NOT RUN in the report
# and the reason is listed under Limits. Copy this file to .env.local and fill in what you have.

# Free key from https://etherscan.io/apis . One V2 key covers Ethereum, Base, BNB Chain,
# Arbitrum and Polygon, subject to your plan. Unlocks deployer, deploy block, source
# verification and first/last transactions.
ETHERSCAN_API_KEY=

# X API v2 bearer token (paid tier). Unlocks the current profile, account creation date
# and exact name history by account ID.
X_BEARER_TOKEN=

# https://www.chainabuse.com API key. Unlocks community scam reports.
CHAINABUSE_API_KEY=

# CoinGecko demo key. Optional; raises the rate limit for project-name search.
COINGECKO_API_KEY=
